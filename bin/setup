#!/usr/bin/env bash

# Setup the local development environment for working in this project.

set -e

check_for_homebrew_packages() {
  if ! command -v brew >/dev/null 2>&1; then
    printf "\033[0;33mWarn:\033[0m Could not find 'brew' in PATH. Refer to \033[0;31mBrewfile\033[0m for required packages if not using Homebrew.\n"
    return 0
  fi

  if ! brew bundle check --file=Brewfile >/dev/null 2>&1; then
    printf "\033[0;35mMissing required Homebrew packages. Installing now.\033[0m\n"
    brew bundle --file=Brewfile
  fi
}

check_python_version() {
  # shellcheck disable=SC2155
  local PYTHON_VERSION=$(head -n 1 ".python-version")
  uv python find "${PYTHON_VERSION}" >/dev/null 2>&1 || uv python install --default
}

check_for_git_hooks() {
  # shellcheck disable=SC2155
  local git_version=$(git --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')

  if ! [[ "$(printf '%s\n' "2.54.0" "$git_version" | sort -V | tail -n 1)" == "$git_version" ]]; then
    printf "\033[0;31mError:\033[0m Git version must be at least 2.54.0, found %s\n" "$git_version"
    exit 1
  fi

  if ! [[ $(git hook list pre-push) == "ci" ]]; then
    git config set --local hook.ci.event pre-push
    git config set --local hook.ci.command ./bin/ci
    echo "Added pre-push hook to run CI locally"
  fi

  if ! [[ $(git hook list pre-commit) == "gitleaks" ]]; then
    git config set --local hook.gitleaks.event pre-commit
    git config set --local hook.gitleaks.command "gitleaks git --staged --no-banner --verbose ."
    echo "Added pre-commit hook to run gitleaks locally"
  fi
}

check_for_homebrew_packages
check_python_version
check_for_git_hooks

printf "\033[0;32m  ✔ \033[0mSetup complete\n"
